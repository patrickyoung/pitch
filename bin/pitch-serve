#!/usr/bin/env node
// pitch-serve -- the static server, and the only one.
//
// `tailscale serve <directory>` exists and would have meant no server code at
// all. It does not survive cross-origin isolation: SharedArrayBuffer, and so
// threaded WASM, needs COOP and COEP on the response and a static file target
// has nowhere to put a header. The same gap makes .wasm arriving as
// application/octet-stream unfixable, and instantiateStreaming refuses it.
//
// So: one server, and it earns its keep twice, because the checker serves the
// site through it too. What is checked is byte for byte what is served.
//
//   pitch-serve [-p port] [-r sites-dir]
//
// A site is a directory under the root and its name is its path:
//   sites/clock/index.html  ->  http://127.0.0.1:8787/clock/

import fs from 'node:fs';
import http from 'node:http';
import path from 'node:path';

const HERE = path.dirname(path.dirname(fs.realpathSync(new URL(import.meta.url).pathname)));

const argv = process.argv.slice(2);
const opt = { port: Number(process.env.PITCH_PORT || 8787), root: process.env.PITCH_SITES || path.join(HERE, 'sites') };
for (let i = 0; i < argv.length; i++) {
	if (argv[i] === '-p') opt.port = Number(argv[++i]);
	else if (argv[i] === '-r') opt.root = argv[++i];
	else if (argv[i] === '-h' || argv[i] === '--help') {
		process.stdout.write('usage: pitch-serve [-p port] [-r sites-dir]\n');
		process.exit(0);
	} else { process.stderr.write(`pitch-serve: unknown argument ${argv[i]}\n`); process.exit(2); }
}
// Port 0 is legal and means "pick one": a build serves its staging tree on an
// ephemeral port so two builds cannot collide, and writes it to $PITCH_PORT_FILE.
if (!Number.isInteger(opt.port) || opt.port < 0) { process.stderr.write('pitch-serve: -p wants a port\n'); process.exit(2); }
opt.root = path.resolve(opt.root);

// The same rule as every other program here, and deliberately the same source
// of truth: lib/common.sh has this regexp too, and case 2 of the suite runs
// both against the same hostile list. The name is a path, a URL, a git
// repository, a gateway and a program name -- validating it in some of those
// places is how this becomes a remote shell.
const NAME = /^[a-z][a-z0-9-]{0,30}[a-z0-9]$|^[a-z]$/;

const TYPES = {
	'.html': 'text/html; charset=utf-8',
	'.js': 'text/javascript; charset=utf-8',
	'.mjs': 'text/javascript; charset=utf-8',
	'.css': 'text/css; charset=utf-8',
	'.json': 'application/json; charset=utf-8',
	'.map': 'application/json; charset=utf-8',
	'.txt': 'text/plain; charset=utf-8',
	'.md': 'text/plain; charset=utf-8',
	'.svg': 'image/svg+xml',
	'.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
	'.gif': 'image/gif', '.webp': 'image/webp', '.avif': 'image/avif',
	'.ico': 'image/x-icon',
	'.woff2': 'font/woff2', '.woff': 'font/woff',
	// The one that matters. Without it instantiateStreaming refuses the module
	// and the failure surfaces in the app, a long way from here.
	'.wasm': 'application/wasm',
	'.webmanifest': 'application/manifest+json',
	'.webm': 'video/webm', '.mp3': 'audio/mpeg', '.wav': 'audio/wav',
	'.csv': 'text/csv; charset=utf-8',
	'.jsonl': 'application/x-ndjson',
};

const send = (res, code, body, headers = {}) => {
	res.writeHead(code, { 'content-type': 'text/plain; charset=utf-8', ...headers });
	res.end(body);
};

// Resolve a request to a real file inside one site, or to nothing. realpath is
// the load-bearing call: a symlink inside a site pointing at ~/.ssh resolves
// out of the tree, and a prefix test on the unresolved path would not notice.
function resolve(site, rest) {
	const root = path.join(opt.root, site);
	let real;
	try { real = fs.realpathSync(root); } catch { return null; }
	const want = path.resolve(real, '.' + (rest.startsWith('/') ? rest : '/' + rest));
	if (want !== real && !want.startsWith(real + path.sep)) return null;
	let abs;
	try { abs = fs.realpathSync(want); } catch { return null; }
	if (abs !== real && !abs.startsWith(real + path.sep)) return null;
	return abs;
}

const server = http.createServer((req, res) => {
	if (req.method !== 'GET' && req.method !== 'HEAD')
		return send(res, 405, 'only GET and HEAD\n', { allow: 'GET, HEAD' });

	// Split the path off by hand rather than through URL. `GET //counter/`
	// is a legal request and `new URL('//counter/', base)` reads the leading
	// `//` as an *authority*, so the path becomes `/` and the root listing is
	// served for a request that named a site. Nothing here needs a URL object;
	// what it needs is the bytes between the method and the query.
	const raw = req.url.split(/[?#]/, 1)[0];
	const query = req.url.slice(raw.length);
	if (!raw.startsWith('/')) return send(res, 400, 'bad request\n');

	let decoded;
	try { decoded = decodeURIComponent(raw); } catch { return send(res, 400, 'bad escape\n'); }
	if (decoded.includes('\0')) return send(res, 400, 'bad request\n');

	if (decoded === '/') {
		let names = [];
		try {
			names = fs.readdirSync(opt.root, { withFileTypes: true })
				.filter(d => d.isDirectory() && NAME.test(d.name)).map(d => d.name).sort();
		} catch { /* an empty tree is not an error; it is the first run */ }
		return send(res, 200, names.map(n => `/${n}/`).join('\n') + (names.length ? '\n' : ''));
	}

	// Every browser asks for this whether or not a page mentions it, and the
	// root of this server is not a site. Answering 403 puts an error in the
	// console of every page here, for a file nobody asked for.
	if (decoded === '/favicon.ico') { res.writeHead(204); return res.end(); }

	const parts = decoded.split('/').filter(Boolean);
	const site = parts[0] ?? '';
	if (!NAME.test(site)) return send(res, 403, 'forbidden\n');

	// pitch's own files live in the site directory and are not the site.
	// SPEC.md is what somebody asked for, which on a public site is nobody
	// else's business; `.public`, `.isolate` and `.domain` are configuration.
	// `.well-known` is the one dotted path the web genuinely owns.
	const own = parts.slice(1);
	if (own.some((p, i) => p.startsWith('.') && !(i === 0 && p === '.well-known')) ||
		own[own.length - 1] === 'SPEC.md')
		return send(res, 404, 'not found\n');

	const rest = '/' + parts.slice(1).join('/');
	let abs = resolve(site, rest);
	if (!abs) return send(res, 404, 'not found\n');

	let st;
	try { st = fs.statSync(abs); } catch { return send(res, 404, 'not found\n'); }

	if (st.isDirectory()) {
		// A directory without the trailing slash makes every relative path in
		// the page resolve one level too high, so the page loads and none of
		// its assets do. Redirect rather than serve a subtly broken page.
		if (!decoded.endsWith('/')) return send(res, 301, '', { location: `${raw}/${query}` });
		abs = path.join(abs, 'index.html');
		try { st = fs.statSync(abs); } catch { return send(res, 404, 'no index.html\n'); }
	}
	if (!st.isFile()) return send(res, 404, 'not found\n');

	const headers = {
		'content-type': TYPES[path.extname(abs).toLowerCase()] || 'application/octet-stream',
		'content-length': st.size,
		// An app being refined from a chat is re-fetched constantly and must
		// never be the stale one. Revalidate every time; these are small files.
		'cache-control': 'no-cache',
		'x-content-type-options': 'nosniff',
	};

	// Cross-origin isolation is per site and opt-in, because COEP breaks every
	// CDN response that omits CORP -- which is most of them. Turning it on by
	// default would break the common case to enable the rare one.
	const isolate = path.join(opt.root, site, '.isolate');
	if (fs.existsSync(isolate)) {
		const mode = fs.readFileSync(isolate, 'utf8').trim() || 'require-corp';
		headers['cross-origin-opener-policy'] = 'same-origin';
		headers['cross-origin-embedder-policy'] = mode === 'credentialless' ? 'credentialless' : 'require-corp';
	}

	res.writeHead(200, headers);
	if (req.method === 'HEAD') return res.end();
	fs.createReadStream(abs).pipe(res).on('error', () => res.destroy());
});

// Loopback only. The tailnet is reached through `tailscale serve`, which is
// where the access boundary lives; a server bound to 0.0.0.0 would publish
// every site to the LAN and quietly undo the whole public/private argument.
server.listen(opt.port, '127.0.0.1', () => {
	const { port } = server.address();
	process.stderr.write(`pitch-serve: ${opt.root} on http://127.0.0.1:${port}\n`);
	if (process.env.PITCH_PORT_FILE) fs.writeFileSync(process.env.PITCH_PORT_FILE, String(port));
});
server.on('error', e => { process.stderr.write(`pitch-serve: ${e.message}\n`); process.exit(2); });
