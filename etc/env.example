# ~/.config/pitch/env
#
# No token lives here, unlike hail's config, so there is no mode to refuse.
# It exists because launchd inherits almost no environment and a container
# inherits a different one, and neither is the shell you tested in.

# The static server. Loopback only, always: the access boundary is tailscale,
# and a server on 0.0.0.0 would publish every site to the LAN and quietly undo
# the whole public/private argument.
PITCH_PORT=8787

# Private is 443 and public is 8443, because AllowFunnel is keyed by port and
# not by path. Changing these changes the URLs, so change them once or never.
PITCH_HTTPS_PORT=443
PITCH_FUNNEL_PORT=8443

# Match the model to the job. Writing a whole app is the expensive question;
# a slug, a spec and a one-word classification are not. `ask auth` says what
# this machine is authenticated for.
PITCH_MODEL=openai-codex/gpt-5.6-sol
PITCH_SMALL_MODEL=openai-codex/gpt-5.6-sol

# Failed checks before ply gives up on one build, and how long any single
# command it runs may take.
PITCH_CYCLES=6
PITCH_CMD_TIMEOUT=120s

# Seconds page-check gives one page, and the bytes of same-origin payload it
# will accept. The budget is not a style rule -- it is the line past which
# something is bundled in there.
PITCH_PAGE_TIMEOUT=45
PITCH_BUDGET=512000

# The browser page-check drives. Set it when there is neither a Google Chrome
# app bundle nor a chromium on one of the usual paths.
# CHROME=/usr/bin/chromium

# The tailscale CLI, when it is neither on PATH nor in the Mac app bundle.
# PITCH_TAILSCALE=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# Bytes of a chat thread before it is compacted. There is no fill percentage
# to read, so the size of the session on disk is the proxy; ask exit 2 is the
# backstop when the proxy is wrong.
PITCH_THREAD_MAX=500000
