try "ls on an empty tree prints nothing and exits 0"
empty=$WORK/empty
mkdir -p "$empty"
out=$(PITCH_ROOT=$empty ./bin/pitch ls 2>&1)
[ $? -eq 0 ] || no "ls exited nonzero on an empty tree"
[ -z "$out" ] || no "ls printed \"$out\" for an empty tree"
