#!/bin/sh
# tests/suite -- the definition of done, offline.
#
# No tailnet, no chat network, no model provider, no credentials. A tailscale
# stub keeps state so reconcile can be run twice and asked whether it did
# anything the second time; a ply stub writes a page that passes or one that
# does not, so promotion, refusal and the commit are all checkable without a
# model. The one real dependency is a browser, because page-check's whole job
# is to open the page in one.
set -u

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT" || exit 2

WORK=$(mktemp -d "${TMPDIR:-/tmp}/pitch-check.XXXXXX")
SERVE_PIDS=
cleanup() {
	for p in $SERVE_PIDS; do kill "$p" 2>/dev/null; done
	kill "$(cat "$WORK/mb.pid" 2>/dev/null)" 2>/dev/null
	rm -rf "$WORK"
}
trap cleanup EXIT INT TERM

# The suite reads its own configuration, never the one on this machine. Adding
# PITCH_HOST to ~/.config/pitch/env turned two cases red on a tree that had not
# changed -- which is a check reporting a fact about the developer rather than
# about the code, and the worst kind of false negative because it is *correct*.
PITCH_CONFIG=$WORK/pitch.env
export PITCH_CONFIG
: >"$PITCH_CONFIG"
unset PITCH_HOST PITCH_PORT PITCH_MODEL PITCH_SMALL_MODEL PITCH_BUDGET 2>/dev/null || true

N=0 FAILED=0 DESC= WHY=
try() { N=$((N + 1)); DESC=$1; WHY=; }
no() { [ -n "$WHY" ] || WHY=$1; }
verdict() {
	if [ -z "$WHY" ]; then
		printf 'ok   %2d  %s\n' "$N" "$DESC"
	else
		FAILED=$((FAILED + 1))
		printf 'FAIL %2d  %s\n         %s\n' "$N" "$DESC" "$WHY"
	fi
}

# A server on a port nobody chose, so the suite cannot collide with a running
# pitch-serve or with another copy of itself.
serve_on() {
	pf=$WORK/port.$$.$N
	PITCH_PORT_FILE=$pf ./bin/pitch-serve -p 0 -r "$1" >/dev/null 2>&1 &
	SERVE_PIDS="$SERVE_PIDS $!"
	n=0
	while [ ! -s "$pf" ]; do
		n=$((n + 1)); [ "$n" -gt 100 ] && return 1
		sleep 0.1
	done
	cat "$pf"
}

code() { curl -s -o /dev/null -w '%{http_code}' --path-as-is "$1"; }
header() { curl -sI --path-as-is "$1" | tr '[:upper:]' '[:lower:]' | sed -n "s/^$2: *//p" | tr -d '\r'; }

BAD_NAMES='../../etc/passwd
a;rm -rf ~
.

Pomodoro
-lead
foo-
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'

# --------------------------------------------------------------- 1. lint

try "lint: shell, javascript, the skill, the modes, the example TOML"
for f in bin/pitch bin/pitch-chat bin/check tests/suite tests/ply-stub tests/ask-stub lib/common.sh; do
	sh -n "$f" 2>/dev/null || no "$f is not valid sh"
done
for f in bin/pitch-serve bin/page-check; do
	node --check "$f" >/dev/null 2>&1 || no "$f is not valid javascript"
done
# compile() rather than py_compile: py_compile writes a __pycache__ into the
# tree it was asked to check, and a check that leaves litter behind is a check
# somebody adds to .gitignore instead of fixing.
python3 -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' \
	tests/tailscale-stub >/dev/null 2>&1 || no "tests/tailscale-stub does not compile"
brief lint -q -strict skills/web-house 2>/dev/null || no "skills/web-house does not lint"
for f in bin/pitch bin/pitch-serve bin/page-check bin/pitch-chat bin/check tests/suite \
	tests/ply-stub tests/ask-stub tests/tailscale-stub; do
	[ -x "$f" ] || no "$f is not executable -- a handler that is not executable is not a handler"
done
python3 -c 'import tomllib,sys; tomllib.load(open(sys.argv[1],"rb"))' \
	etc/gateway.toml.example 2>/dev/null || no "etc/gateway.toml.example is not TOML"
# An unknown argument is an error, and -h is not. Nothing tested either, so
# flipping one comparison made *every* unrecognised flag print usage and exit
# 0 -- a silent success in the one place a wrong flag should be loudest.
./bin/pitch-serve -h >/dev/null 2>&1 || no "pitch-serve -h does not exit 0"
case $(./bin/pitch-serve -h 2>&1) in *usage:*) ;; *) no "pitch-serve -h prints no usage" ;; esac
./bin/page-check -h >/dev/null 2>&1 || no "page-check -h does not exit 0"
if ./bin/pitch-serve --nonsense >/dev/null 2>&1; then
	no "pitch-serve accepted an unknown argument and exited 0"
fi
verdict

# ------------------------------------------------- 2. the name is hostile

try "a hostile name is refused identically by every program that takes one"
SERVE_ROOT=$WORK/serveroot
mkdir -p "$SERVE_ROOT/types" "$SERVE_ROOT/iso" "$SERVE_ROOT/plain" "$SERVE_ROOT/esc"
printf 'secret\n' >"$WORK/secret.txt"
for d in types iso plain esc; do
	printf '<!doctype html><html lang=en><title>t</title><body>hi\n' >"$SERVE_ROOT/$d/index.html"
done
printf 'export const a = 1;\n' >"$SERVE_ROOT/types/m.js"
printf '\0asm\1\0\0\0' >"$SERVE_ROOT/types/m.wasm"
printf 'body{color:#000}\n' >"$SERVE_ROOT/types/m.css"
printf 'binary\n' >"$SERVE_ROOT/types/m.bin"
printf 'require-corp\n' >"$SERVE_ROOT/iso/.isolate"
ln -sf "$WORK/secret.txt" "$SERVE_ROOT/esc/out"

PORT=$(serve_on "$SERVE_ROOT") || no "the server would not start"
printf '%s\n' "$BAD_NAMES" | while IFS= read -r n; do
	( . ./lib/common.sh; valid_name "$n" ) 2>/dev/null &&
		printf 'shell accepted "%s"\n' "$n"
	enc=$(printf '%s' "$n" | jq -sRr @uri)
	c=$(code "http://127.0.0.1:$PORT/$enc/")
	case $c in 403 | 404 | 301) ;; *) printf 'the server answered %s for "%s"\n' "$c" "$n" ;; esac
	ln -sf "$ROOT/bin/pitch-chat" "$WORK/link" 2>/dev/null
	:
done >"$WORK/names.out" 2>&1
[ -s "$WORK/names.out" ] && no "$(head -2 "$WORK/names.out" | tr '\n' ';')"
# and the good ones still work, or the rule is merely "no"
( . ./lib/common.sh; valid_name clock && valid_name a && valid_name my-app-2 ) ||
	no "a legitimate name was refused"
[ "$(code "http://127.0.0.1:$PORT/plain/")" = 200 ] || no "a legitimate site was refused"
verdict

# --------------------------------------------- 3. no walking out of a site

try "pitch-serve serves the app, and not pitch's own files inside it"
printf 'secret plans\n' >"$SERVE_ROOT/plain/SPEC.md"
: >"$SERVE_ROOT/plain/.public"
for u in "/plain/SPEC.md" "/plain/.public" "/plain/.isolate" "/plain/.domain"; do
	c=$(code "http://127.0.0.1:$PORT$u")
	[ "$c" = 404 ] || no "$u answered $c -- a public site would hand out what was asked for"
done
[ "$(code "http://127.0.0.1:$PORT/plain/")" = 200 ] || no "the app itself stopped being served"
# .well-known is the one dotted path the web owns, and the exception for it was
# unconstrained: draft prove flipped the comparison that grants it and no case
# noticed. A rule nothing holds to account is a rule that could be backwards.
mkdir -p "$SERVE_ROOT/plain/.well-known"
printf 'ok\n' >"$SERVE_ROOT/plain/.well-known/x.txt"
[ "$(code "http://127.0.0.1:$PORT/plain/.well-known/x.txt")" = 200 ] ||
	no ".well-known is not reachable, and the web expects it to be"
rm -f "$SERVE_ROOT/plain/SPEC.md" "$SERVE_ROOT/plain/.public"
rm -rf "$SERVE_ROOT/plain/.well-known"
verdict

try "pitch-serve cannot be walked out of a site"
for u in "/plain/../../secret.txt" "/plain/%2e%2e/%2e%2e/secret.txt" \
	"/plain//etc/passwd" "/esc/out"; do
	body=$(curl -s --path-as-is "http://127.0.0.1:$PORT$u")
	case $body in *secret*) no "$u served $WORK/secret.txt" ;; esac
	case $body in *root:*) no "$u served /etc/passwd" ;; esac
done
verdict

# ------------------------------------------------------- 4. content types

try "content types, and .wasm above all"
[ "$(header "http://127.0.0.1:$PORT/types/m.wasm" content-type)" = "application/wasm" ] ||
	no "a .wasm is not application/wasm -- instantiateStreaming refuses it"
case $(header "http://127.0.0.1:$PORT/types/m.js" content-type) in
text/javascript*) ;; *) no ".js is not text/javascript" ;;
esac
case $(header "http://127.0.0.1:$PORT/types/index.html" content-type) in
*charset=utf-8) ;; *) no ".html carries no charset" ;;
esac
[ "$(header "http://127.0.0.1:$PORT/types/m.bin" content-type)" = "application/octet-stream" ] ||
	no "an unknown extension is not octet-stream"
verdict

# ------------------------------------------------- 5. isolation is opt-in

try "cross-origin isolation is opt-in, and off means absent"
[ "$(header "http://127.0.0.1:$PORT/iso/" cross-origin-opener-policy)" = "same-origin" ] ||
	no ".isolate did not turn COOP on"
[ "$(header "http://127.0.0.1:$PORT/iso/" cross-origin-embedder-policy)" = "require-corp" ] ||
	no ".isolate did not turn COEP on"
[ -z "$(header "http://127.0.0.1:$PORT/plain/" cross-origin-opener-policy)" ] ||
	no "COOP is set on a site with no .isolate"
verdict

# -------------------------------------------- 6, 7, 8. what page-check says

PAGES_PORT=$(serve_on "$ROOT/tests/pages") || PAGES_PORT=

pc() { ./bin/page-check -timeout "${2:-25}" "http://127.0.0.1:$PAGES_PORT/$1/" 2>&1; }

try "page-check passes a page that is done, and says why for one that is not"
[ -n "$PAGES_PORT" ] || no "the fixture server would not start"
out=$(pc good); [ $? -eq 0 ] || no "the good fixture failed: $out"
for pair in 'noisy console' 'noisy exception' 'broken request' 'wide layout' \
	'nameless a11y' 'dim contrast' 'insecure mixed' 'insecure pin'; do
	set -- $pair
	out=$(pc "$1")
	[ $? -eq 0 ] && { no "$1 passed and must not"; continue; }
	case $out in *"$2:"*) ;; *) no "$1 failed, but not for $2: $(printf '%s' "$out" | tr '\n' ';')" ;; esac
done
verdict

try "an inert page fails, and a page with no controls at all does not"
out=$(pc inert)
[ $? -eq 0 ] && no "the inert fixture passed"
case $out in *inert:*) ;; *) no "inert did not fail as inert: $out" ;; esac
out=$(pc alive)
[ $? -eq 0 ] || no "a clock, which has no controls and is correct, was called inert: $out"
verdict

try "a page that never settles is bounded, and reported as a timeout"
out=$(./bin/page-check -timeout 4 "http://127.0.0.1:$PAGES_PORT/slow/" 2>&1)
st=$?
[ "$st" = 1 ] || no "expected exit 1 for a page that never loads, got $st"
case $out in *timeout:*) ;; *) no "it did not say it timed out: $(printf '%s' "$out" | tail -1)" ;; esac
case $out in *"(6"*times*) ;; *[0-9]" times)"*) ;; *) no "68 identical 404s were not folded" ;; esac
verdict

# ------------------------------------------------------ 9-12, 14. building

# A whole tree of its own, with the stubs standing in for the model.
NEWROOT=$WORK/tree
mkdir -p "$NEWROOT"
cp -R "$ROOT/skills" "$NEWROOT/skills"
export PITCH_ROOT=$NEWROOT
export ASK=$ROOT/tests/ask-stub
export PLY=$ROOT/tests/ply-stub
export PITCH_TAILSCALE=$ROOT/tests/tailscale-stub
export STUB_STATE=$WORK/ts.json
export STUB_LOG=$WORK/stub.log
export PITCH_PAGE_TIMEOUT=25

try "the first run on an empty tree builds, commits, and creates what it needs"
[ -e "$NEWROOT/sites" ] && no "the tree was not empty to begin with"
url=$(./bin/pitch new counter 'a counter' 2>"$WORK/new.err")
st=$?
[ "$st" = 0 ] || no "pitch new failed on an empty tree: $(tail -2 "$WORK/new.err")"
[ -f "$NEWROOT/sites/counter/index.html" ] || no "no index.html was published"
[ -f "$NEWROOT/sites/counter/SPEC.md" ] || no "no SPEC.md was kept"
[ -d "$NEWROOT/sites/counter/.git" ] || no "the site is not a git repository"
[ -d "$NEWROOT/build/counter" ] && no "the staging tree was left behind"
[ "$(ls "$NEWROOT"/log/counter/*.jsonl 2>/dev/null | wc -l)" -ge 1 ] || no "nothing was logged"
# The doctrine has to reach the call that writes the spec. It did not for a
# long time: `BRIEF_PATH=x ask -S "$(brief cat web-house)"` expands the
# substitution in *this* shell, where the prefix has not been applied, so brief
# ran with no path and said so on a stderr nobody was reading.
grep -q "import map" "$STUB_LOG" ||
	no "the spec was written without web-house in its system prompt"
case $url in https://mac.tail1234.ts.net/counter/) ;; *) no "the url printed was \"$url\"" ;; esac
verdict

try "an existing name is refused, never overwritten"
before=$(cat "$NEWROOT/sites/counter/index.html")
./bin/pitch new counter 'something else' >/dev/null 2>&1 && no "it accepted a name that exists"
[ "$(cat "$NEWROOT/sites/counter/index.html")" = "$before" ] || no "the existing site was changed"
verdict

try "a failed check publishes nothing, and the last good page is still up"
head=$(git -C "$NEWROOT/sites/counter" rev-parse HEAD)
before=$(cat "$NEWROOT/sites/counter/index.html")
STUB_PLY=fail ./bin/pitch say counter 'make it worse' >/dev/null 2>&1 &&
	no "a failing build reported success"
[ "$(git -C "$NEWROOT/sites/counter" rev-parse HEAD)" = "$head" ] || no "a failing build committed"
[ "$(cat "$NEWROOT/sites/counter/index.html")" = "$before" ] || no "a failing build changed the live page"
[ -d "$NEWROOT/build/counter" ] && no "the failed staging tree was left behind"
verdict

try "a change is an edit, not a rebuild, and says how much of the file moved"
: >"$STUB_LOG"
out=$(./bin/pitch say counter 'make the button bigger' 2>"$WORK/say.err") ||
	no "a passing change failed: $(tail -2 "$WORK/say.err")"
# The goal handed over for a change must be the edit one. Handing over the
# build goal is what made every request rewrite the whole app: SPEC.md grows
# one section per request, so "build the app SPEC.md describes" becomes "redo
# all of it" by the fifth message.
grep -q "smallest edit" "$STUB_LOG" ||
	no "a change was given the build goal, not the edit goal: $(head -c 200 "$STUB_LOG")"
grep -q -- "-compact" "$STUB_LOG" ||
	no "ply was not given -compact, so a long build dies of its own transcript"
[ -e "$NEWROOT/sites/counter/.change" ] &&
	no ".change was published with the site"
case $out in
*"lines changed"*) ;;
*) no "no gauge of how much of the file moved: $out" ;;
esac
[ "$(git -C "$NEWROOT/sites/counter" log -1 --format=%s)" = "make the button bigger" ] ||
	no "the commit message is not the message that asked for it"
[ "$(git -C "$NEWROOT/sites/counter" log -1 --format=%s)" = "make the button bigger" ] ||
	no "the commit does not carry what was asked for"
./bin/pitch back counter >/dev/null 2>&1 || no "back would not revert"
[ "$(git -C "$NEWROOT/sites/counter" log -1 --format=%s)" != "make the button bigger" ] ||
	no "back did not revert"
verdict

try "one build per site: a second change is refused, not run on top of the first"
# The staging path is fixed per site, and the chat handler forks past heed's
# per-gateway lock -- so two messages a minute apart ran concurrently, and the
# second's `rm -rf` deleted the first's working tree out from under ply.
mkdir -p "$NEWROOT/state/counter.lock"
date -u +%s >"$NEWROOT/state/counter.lock/at"
out=$(./bin/pitch say counter 'while another is running' 2>&1) &&
	no "a second change ran while one was already building"
case $out in *"already building"*) ;; *) no "the refusal does not say why: $out" ;; esac
out=$(./bin/pitch land counter 2>&1) && no "land ran while a build held the lock"
rm -rf "$NEWROOT/state/counter.lock"
# and a lock older than any build could be is not a lock
mkdir -p "$NEWROOT/state/counter.lock"
printf '0\n' >"$NEWROOT/state/counter.lock/at"
./bin/pitch say counter 'after a stale lock' >/dev/null 2>&1 ||
	no "a stale lock was never broken"
verdict

try "land folds a run of tweaks into one commit and rewrites the spec"
n0=$(git -C "$NEWROOT/sites/counter" rev-list --count HEAD)
[ "$n0" -ge 3 ] || no "expected several commits to land, found $n0"
tree0=$(git -C "$NEWROOT/sites/counter" rev-parse HEAD^{tree})
out=$(./bin/pitch land counter 2>&1) || no "land failed: $out"
n1=$(git -C "$NEWROOT/sites/counter" rev-list --count HEAD)
[ "$n1" -lt "$n0" ] || no "land did not fold anything: $n0 commits before, $n1 after"
# The artifact must not move. That is the whole promise of this shape.
[ "$(git -C "$NEWROOT/sites/counter" rev-parse HEAD^{tree})" != "$tree0" ] ||
	no "land did not rewrite SPEC.md -- the tree is unchanged"
[ "$(cat "$NEWROOT/sites/counter/index.html")" = "$(git -C "$NEWROOT/sites/counter" show "$tree0:index.html")" ] ||
	no "land changed the app; it may only change the spec and the history"
git -C "$NEWROOT/sites/counter" rev-parse -q --verify landed >/dev/null ||
	no "no landed tag, so the next run has nothing to measure from"
out=$(./bin/pitch land counter 2>&1) && no "landing twice with nothing in between was allowed"
case $out in *"nothing to land"*) ;; *) no "the refusal does not say why: $out" ;; esac
verdict

try "drop throws away everything since the last landing"
./bin/pitch say counter 'a tweak to abandon' >/dev/null 2>&1 || no "the tweak failed"
head0=$(git -C "$NEWROOT/sites/counter" rev-parse landed)
./bin/pitch drop counter >/dev/null 2>&1 || no "drop failed"
[ "$(git -C "$NEWROOT/sites/counter" rev-parse HEAD)" = "$head0" ] ||
	no "drop did not return to the landed commit"
out=$(./bin/pitch drop counter 2>&1) && no "dropping with nothing to drop was allowed"
case $out in *"nothing to drop"*) ;; *) no "the refusal does not say why: $out" ;; esac
verdict

try "a build has a wall clock, and a stuck one is reported by name"
# -cycles bounds the loop and -timeout bounds one command, and neither bounds
# the run: a ply worked a deleted directory for 23 hours 47 minutes, calling a
# model, and nothing noticed. The group matters as much as the clock -- killing
# the shell leaves the interpreter running.
t0=$(date +%s)
st=0
( . ./lib/common.sh
  eval "$(sed -n '/^bounded() {/,/^}/p' ./bin/pitch)"
  bounded 2 sh -c 'sleep 60 & sleep 60' ) >/dev/null 2>&1 || st=$?
took=$(($(date +%s) - t0))
[ "$took" -le 12 ] || no "a runaway ran for ${took}s past a 2s bound"
[ "$st" != 0 ] || no "a killed build reported success"
[ "$(pgrep -f 'sleep 60' | wc -l | tr -d ' ')" = 0 ] ||
	no "the grandchild survived -- killing the shell left the interpreter running"

# and doctor names it, rather than leaving it to be noticed a day later
mkdir -p "$NEWROOT/state/wedged.lock"
printf '%s\n' "$(( $(date -u +%s) - 99999 ))" >"$NEWROOT/state/wedged.lock/at"
out=$(PITCH_ROOT=$NEWROOT ./bin/pitch doctor 2>&1 || true)
case $out in
*"outlived any build"*) ;;
*) no "doctor said nothing about a build stuck for a day: $(printf '%s' "$out" | grep -i build)" ;;
esac
case $out in *wedged*) ;; *) no "doctor did not name the stuck build" ;; esac
PITCH_ROOT=$NEWROOT ./bin/pitch doctor >/dev/null 2>&1 && no "doctor exited 0 with a build stuck"
rm -rf "$NEWROOT/state/wedged.lock"
verdict

try "a capability is data, and the interpreter refuses what it cannot check"
# The builder writes these, so a capability must never be able to cause more
# than one ask call with a prompt. Everything below is what stops a manifest
# from becoming a program, an unbounded bill, or garbage in somebody's page.
AG=$NEWROOT/sites/counter/agent
mkdir -p "$AG" "$NEWROOT/log/counter/agent"
cat >"$AG/good" <<'M'
skill: web-house
requires: mood palette
prompt:
say something
M
printf 'requires: mood\n' >"$AG/nopropmt"
printf 'prompt:\nhi\n' >"$AG/nokeys"

APF=$WORK/agentport
PITCH_AGENT_PORT_FILE=$APF ASK=$ROOT/tests/ask-stub BRIEF_PATH=$ROOT/skills \
	PITCH_ROOT=$NEWROOT ./bin/pitch-agent -p 0 >"$WORK/agent.log" 2>&1 &
SERVE_PIDS="$SERVE_PIDS $!"
n=0; while [ ! -s "$APF" ]; do n=$((n + 1)); [ "$n" -gt 100 ] && break; sleep 0.1; done
AP=$(cat "$APF" 2>/dev/null)
post() { curl -s -o "$WORK/ag.out" -w '%{http_code}' --max-time 30 -X POST \
	-H 'content-type: application/json' --data "$2" \
	"http://127.0.0.1:$AP/counter/agent/$1"; }

[ -n "$AP" ] || no "the interpreter would not start"
if [ -n "$AP" ]; then
	[ "$(post nokeys '{}')" = 500 ] ||
		no "a capability that names no required keys was accepted -- it can never fail honestly"
	[ "$(post nopropmt '{}')" = 500 ] || no "a capability with no prompt was accepted"
	[ "$(post missing '{}')" = 404 ] || no "an unknown capability was not 404"
	# --path-as-is, or curl normalises the traversal away before it is sent and
	# the case proves nothing. Anything but a refusal is a finding.
	c=$(curl -s -o /dev/null -w '%{http_code}' --path-as-is --max-time 10 -X POST \
		--data '{}' "http://127.0.0.1:$AP/counter/agent/../../../../etc/passwd")
	case $c in 403 | 404) ;; *) no "a traversing capability name answered $c" ;; esac
	c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 \
		"http://127.0.0.1:$AP/counter/agent/good")
	[ "$c" = 405 ] || no "GET was not refused"

	# Prose where the page expects an object is a broken app, not an answer.
	# A second interpreter, because the stub is a child of the server and
	# inherits the environment the *server* was started with -- setting a
	# variable on curl reaches curl and nothing else.
	PPF=$WORK/proseport
	PITCH_AGENT_PORT_FILE=$PPF STUB_PROSE=1 ASK=$ROOT/tests/ask-stub BRIEF_PATH=$ROOT/skills \
		PITCH_ROOT=$NEWROOT ./bin/pitch-agent -p 0 >"$WORK/prose.log" 2>&1 &
	SERVE_PIDS="$SERVE_PIDS $!"
	n=0; while [ ! -s "$PPF" ]; do n=$((n + 1)); [ "$n" -gt 100 ] && break; sleep 0.1; done
	PP=$(cat "$PPF" 2>/dev/null)
	c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 -X POST \
		-H 'content-type: application/json' --data '{}' \
		"http://127.0.0.1:$PP/counter/agent/good")
	[ "$c" = 502 ] || no "prose from the model answered $c instead of failing"

	# Images: capped, and only the types it says it takes. The body goes
	# through a file, because a 6 MB shell argument is longer than ARG_MAX and
	# the first version of this measured that instead of the cap.
	python3 -c 'import sys; sys.stdout.write("{\"image\":\"data:image/png;base64,%s\"}" % ("A"*5500000))' \
		>"$WORK/big.json"
	c=$(curl -s -o "$WORK/ag.out" -w '%{http_code}' --max-time 30 -X POST \
		-H 'content-type: application/json' --data-binary @"$WORK/big.json" \
		"http://127.0.0.1:$AP/counter/agent/good")
	[ "$c" = 413 ] || no "an oversized image answered $c"
	grep -qi image "$WORK/ag.out" 2>/dev/null ||
		no "the refusal does not say it was the image: $(head -c 100 "$WORK/ag.out")"
	[ "$(post good '{"image":"data:application/x-sh;base64,aGk="}')" = 415 ] ||
		no "a shell script offered as an image was accepted"
fi
verdict

try "capabilities are tailnet only, and a site with one cannot be published"
# Funnel is keyed by port, so this is the shape of the serve config rather than
# a promise: the agent path is added to 443 and to nothing else.
want=$(PITCH_ROOT=$NEWROOT ./bin/pitch desired 2>/dev/null)
printf '%s\n' "$want" | grep -q '^443 /counter/agent ' ||
	no "the agent path is not served on the tailnet port"
printf '%s\n' "$want" | grep -E '^(8443|[0-9]+) /counter/agent ' | grep -qv '^443 ' &&
	no "the agent path is served on a port other than 443"
: >"$NEWROOT/sites/counter/.public"
out=$(PITCH_ROOT=$NEWROOT ./bin/pitch open counter 2>&1) && no "a site with capabilities was published"
case $out in *agent*) ;; *) no "the refusal does not say why: $out" ;; esac
rm -f "$NEWROOT/sites/counter/.public"
# Put the tree back: a later case publishes this site, and a capability left
# lying about would refuse it for a reason that has nothing to do with that case.
rm -rf "$NEWROOT/sites/counter/agent"
verdict

try "ward reports what is down as down, and can change nothing"
# A dashboard that says ok when nothing is running is worse than no dashboard:
# every failure this system has had was a component that was up and not
# working, so the one thing ward may never do is flatter the machine.
WARDCFG=$WORK/ward.env
printf 'PITCH_PORT=%s\n' "$((20000 + $$ % 40000))" >"$WARDCFG"   # nothing listens there
mkdir -p "$WORK/nostub"
printf '#!/bin/sh\nexit 1\n' >"$WORK/nostub/docker"
chmod +x "$WORK/nostub/docker"
before=$(find "$NEWROOT" -type f | sort | md5 2>/dev/null || find "$NEWROOT" -type f | sort | md5sum)
PITCH_CONFIG=$WARDCFG PITCH_TAILSCALE=/nonexistent PATH="$WORK/nostub:$PATH" \
	PITCH_ROOT=$NEWROOT ./bin/ward >/dev/null 2>&1 || no "ward exited nonzero with everything down"

S=$NEWROOT/sites/ward/state.json
[ -s "$S" ] || no "ward wrote no state"
for c in pitch-serve tailscale; do
	st=$(jq -r --arg c "$c" '.components[] | select(.name==$c) | .state' "$S" 2>/dev/null)
	[ "$st" = down ] || no "$c is $st when nothing is running -- a dashboard may not flatter the machine"
done
jq -e '.components | length >= 4' "$S" >/dev/null 2>&1 || no "ward reported almost nothing"

# Tokens are arithmetic over sessions ask already wrote, counted for today
# only. A session from yesterday cannot change and must not be re-read.
mkdir -p "$NEWROOT/log/counter"
sess=$NEWROOT/log/counter/build-20260101T000000Z.jsonl
printf '%s\n' \
	'{"seq":1,"type":"session","data":{"id":"x"}}' \
	'{"seq":2,"type":"assistant","data":{"usage":{"in":100,"out":7}}}' \
	'{"seq":3,"type":"assistant","data":{"usage":{"in":900,"out":3}}}' >"$sess"
old=$NEWROOT/log/counter/build-19990101T000000Z.jsonl
printf '%s\n' '{"seq":2,"type":"assistant","data":{"usage":{"in":999999,"out":999999}}}' >"$old"
touch -t 200001010000 "$old"
rm -f "$NEWROOT/state/ward.tokens.json"
PITCH_CONFIG=$WARDCFG PITCH_TAILSCALE=/nonexistent PATH="$WORK/nostub:$PATH" \
	PITCH_ROOT=$NEWROOT ./bin/ward >/dev/null 2>&1
got=$(jq -r '.tokens[] | select(.name=="counter") | "\(.in) \(.out)"' "$S" 2>/dev/null)
[ "$got" = "1000 10" ] || no "tokens for counter came out as \"$got\", wanted \"1000 10\" summed over today only"
jq -e '[.tokens[].in] | add < 999999' "$S" >/dev/null 2>&1 ||
	no "a session from another year was counted in today's total"
# and the second run must not re-read what has not moved
[ -s "$NEWROOT/state/ward.tokens.json" ] || no "no token cache, so every tick re-reads every transcript"

# The crier's bulletins reach the page from clerk's done spool, read-only:
# ward asks nothing to publish, it reads what was already written.
CFIX=$WORK/clerkfix
mkdir -p "$CFIX/workers/crier/spool/done/bulletin-20260101"
printf 'Yesterday was quiet.\n' >"$CFIX/workers/crier/spool/done/bulletin-20260101/BULLETIN.md"
PITCH_CONFIG=$WARDCFG PITCH_TAILSCALE=/nonexistent PATH="$WORK/nostub:$PATH" \
	CLERK_ROOT=$CFIX PITCH_ROOT=$NEWROOT ./bin/ward >/dev/null 2>&1
jq -e '.bulletins[0].worker == "crier" and (.bulletins[0].text | startswith("Yesterday"))' \
	"$S" >/dev/null 2>&1 || no "the bulletin did not reach state.json"

# Its page, its two caches under state/ward.*, and nothing else anywhere. The
# marker is taken after the fixtures, so only what ward itself writes is in
# scope -- an earlier version blamed it for files the test had just created.
marker=$WORK/ward.marker
: >"$marker"
sleep 1
PITCH_CONFIG=$WARDCFG PITCH_TAILSCALE=/nonexistent PATH="$WORK/nostub:$PATH" \
	PITCH_ROOT=$NEWROOT ./bin/ward >/dev/null 2>&1
stray=$(find "$NEWROOT" -newer "$marker" -type f \
	-not -path '*/sites/ward/*' -not -name 'ward.telegram*' -not -name 'ward.tokens*' 2>/dev/null)
[ -z "$stray" ] || no "ward wrote outside its own files: $(printf '%s' "$stray" | head -2 | tr '\n' ' ')"
jq -e '.host != null and .now > 0' "$S" >/dev/null 2>&1 || no "ward wrote no timestamp to derive ages from"

# The probe verdict is written down; the token never is.
grep -rqi "$(sed -n 's/^ *Token *= *"\(.*\)".*/\1/p' "$WORK/mb3.toml" 2>/dev/null || echo ZZZUNLIKELY)" \
	"$NEWROOT/sites/ward/" 2>/dev/null && no "a bot token reached the page"

# The drill-down: each site carries its own story -- the git history with
# the moved-lines gauge, the spec, and an activity list -- so the page can
# show how an app is evolving without asking anything new to be recorded.
jq -e '.sites[] | select(.name=="counter")
	| ((.history | length) >= 1) and ((.spec | length) > 0)
	  and ((.activity | type) == "array") and ((.history[0] | has("moved")))' \
	"$S" >/dev/null 2>&1 || no "state.json carries no drill-down for counter"

# The page's one question is a manifest pitch-agent interprets -- data, not
# a program -- and a manifest that requires nothing cannot fail honestly.
M=$NEWROOT/sites/ward/agent/explain
[ -f "$M" ] || no "ward installed no explain manifest"
grep -q '^requires: *answer' "$M" 2>/dev/null || no "the explain manifest names no required key"
awk '/^prompt:/ { p = 1; next } p && NF { ok = 1 } END { exit !ok }' "$M" 2>/dev/null ||
	no "the explain manifest has no prompt"

verdict

try "the page that reports the truth cannot be rewritten by a model, or published"
[ -f "$NEWROOT/sites/ward/.generated" ] || no "ward left no marker, so nothing knows it is generated"
for v in say land drop back open; do
	case $v in
	say) out=$(PITCH_ROOT=$NEWROOT ./bin/pitch say ward "redesign it" 2>&1) ;;
	*) out=$(PITCH_ROOT=$NEWROOT ./bin/pitch "$v" ward 2>&1) ;;
	esac
	[ $? -eq 0 ] && no "pitch $v accepted a generated site"
	case $out in *generated*) ;; *) no "pitch $v refused for the wrong reason: $out" ;; esac
done
verdict

try "doctor asks the port, and knows a stale server from a launchd one"
# A real server on a port of its own, because doctor asks the port rather than
# a pid file: launchd writes no pid file of ours, and consulting one reported
# "not running" about the ordinary install.
DPORT=$(serve_on "$NEWROOT/sites") || no "the doctor's server would not start"
printf 'PITCH_PORT=%s\n' "$DPORT" >"$PITCH_CONFIG"

printf '1\n' >"$NEWROOT/.serve.stamp"          # started by pitch up, since moved on
out=$(./bin/pitch doctor 2>&1 || true)
case $out in
*"older than bin/pitch-serve"*) ;;
*) no "a stale server was reported as ok: $(printf '%s' "$out" | grep -i serve)" ;;
esac

rm -f "$NEWROOT/.serve.stamp"                  # no stamp: launchd started it
out=$(./bin/pitch doctor 2>&1 || true)
case $out in
*"nothing is serving"*) no "a launchd server was reported as not running -- the ordinary install" ;;
*"older than"*) no "a launchd server was reported as stale" ;;
*"pitch-serve up on 127.0.0.1:$DPORT"*) ;;
*) no "doctor said something unexpected: $(printf '%s' "$out" | grep -i serve)" ;;
esac

printf 'PITCH_PORT=%s\n' "$((DPORT + 1))" >"$PITCH_CONFIG"   # nothing there
out=$(./bin/pitch doctor 2>&1 || true)
case $out in
*"nothing is serving"*) ;;
*) no "doctor did not notice an unserved port: $(printf '%s' "$out" | grep -i serve)" ;;
esac
