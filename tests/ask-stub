#!/bin/sh
# tests/ask-stub -- stands in for ask. The suite reaches no model provider.
#
# `ask system` prints something; a slug question gets a slug; anything else
# gets a spec-shaped document. Nothing here is clever: the point is that every
# case around the model runs with no network and no credentials.
set -eu

[ "${1:-}" = "system" ] && { printf 'you are a stub\n'; exit 0; }

want=$(cat 2>/dev/null || true)
# One line per call. Prompts are multi-line, so logging "$*" raw makes a single
# call span many lines and every `grep -v '^ask '` in the suite then reads a
# continuation line as if it came from somewhere else.
printf 'ask %s\n' "$(printf '%s' "$*" | tr '\n' ' ')" >>"${STUB_LOG:-/dev/null}"

# A model that answers with prose where an object was asked for -- the one
# thing the interpreter must never pass through to a page.
#
# Two ways in, because there are two ways to reach this stub. $STUB_PROSE is
# for a caller that owns the server's environment, which means starting a
# second interpreter; the body marker is for one that only owns the request. A
# variable set on a curl call reaches curl and nothing else, and that mistake
# is easy enough to make twice.
[ -n "${STUB_PROSE:-}" ] && { printf 'Certainly! Here are some lovely colours.\n'; exit 0; }
case $want in *'"prose"'*) printf 'Certainly! Here are some lovely colours.\n'; exit 0 ;; esac

case " $* " in
*"say something"*)
	printf '{"mood":"calm","palette":["#111","#eee"]}\n'
	;;
*"Describe the attached image"*)
	# A picture becomes words exactly once, at the edge. Nothing downstream
	# ever sees the image, so this is the whole of the conversion.
	printf '%s\n' "${STUB_SHOWN:-a wall of mint green with one round button}"
	;;
*"one word and nothing else"*)
	# Both classifiers ask this. $STUB_VERB is what they get back, and the
	# default is the harmless one -- the same default the real thing falls
	# back to when the call fails.
	printf '%s\n' "${STUB_VERB:-ask}"
	;;
*"a name for the app"*)
	printf '%s\n' "${STUB_SLUG:-counter}"
	;;
*)
	cat <<EOF
# ${STUB_SLUG:-counter}

A stub spec, written without a model.

## What it must do
- [ ] it counts
- [ ] it starts at zero

## Notes
Asked for: $want
EOF
	;;
esac
